# Endereço da API.
#
# Em desenvolvimento deixe vazio ou comentado: o Vite tem um proxy que
# encaminha /api para http://localhost:4000 (veja vite.config.js).
#
# Em produção aponte para a URL pública da API, incluindo /api no final:
#   VITE_API_URL=https://caixa-certo-api.onrender.com/api
# VITE_API_URL=

# Porta usada pelo proxy do Vite em desenvolvimento
VITE_API_PROXY=http://localhost:4000
